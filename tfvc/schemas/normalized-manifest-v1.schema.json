{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iqinfra/azdophelpers/tfvc/schemas/normalized-manifest-v1.schema.json",
  "title": "Normalized TFVC review manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1]
    },
    "normalizationVersion": {
      "type": "integer",
      "enum": [1]
    },
    "helperVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "apiVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "changeset": {
      "type": "integer",
      "minimum": 1
    },
    "previousChangeset": {
      "type": "integer",
      "minimum": 0
    },
    "reviewRoot": {
      "type": "string",
      "pattern": "^\\$/[^\\r\\n\\t]+$",
      "maxLength": 2000
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "reviewPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\$/[^\\r\\n\\t]+$",
        "maxLength": 2000
      }
    }
  },
  "required": [
    "schemaVersion",
    "normalizationVersion",
    "helperVersion",
    "apiVersion",
    "changeset",
    "previousChangeset",
    "reviewRoot",
    "coverage",
    "files",
    "reviewPaths"
  ],
  "$defs": {
    "nullableText": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 12000
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewComplete": {
          "type": "boolean",
          "enum": [true]
        },
        "enumeratedChanges": {
          "type": "integer",
          "minimum": 1
        },
        "inScopeChanges": {
          "type": "integer",
          "minimum": 1
        },
        "outOfScopeChanges": {
          "type": "integer",
          "minimum": 0
        },
        "unreviewableChanges": {
          "type": "integer",
          "enum": [0]
        },
        "filesWithTextDiff": {
          "type": "integer",
          "minimum": 0
        },
        "diffBytes": {
          "type": "integer",
          "minimum": 0
        },
        "diffLines": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "reviewComplete",
        "enumeratedChanges",
        "inScopeChanges",
        "outOfScopeChanges",
        "unreviewableChanges",
        "filesWithTextDiff",
        "diffBytes",
        "diffLines"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "changeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "pattern": "^\\$/[^\\r\\n\\t]+$",
          "maxLength": 2000
        },
        "sourceServerItem": {
          "$ref": "#/$defs/nullablePath"
        },
        "oldPath": {
          "$ref": "#/$defs/nullablePath"
        },
        "newPath": {
          "$ref": "#/$defs/nullablePath"
        },
        "oldSize": {
          "type": "integer",
          "minimum": 0
        },
        "newSize": {
          "type": "integer",
          "minimum": 0
        },
        "oldHash": {
          "$ref": "#/$defs/nullableHash"
        },
        "newHash": {
          "$ref": "#/$defs/nullableHash"
        },
        "reviewable": {
          "type": "boolean",
          "enum": [true]
        },
        "textDiff": {
          "type": "boolean"
        },
        "reason": {
          "type": "null"
        }
      },
      "required": [
        "index",
        "changeType",
        "classification",
        "path",
        "sourceServerItem",
        "oldPath",
        "newPath",
        "oldSize",
        "newSize",
        "oldHash",
        "newHash",
        "reviewable",
        "textDiff",
        "reason"
      ]
    },
    "nullablePath": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\$/[^\\r\\n\\t]+$",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableHash": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
