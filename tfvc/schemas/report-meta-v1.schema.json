{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iqinfra/azdophelpers/tfvc/schemas/report-meta-v1.schema.json",
  "title": "TFVC Codex report metadata v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "metaVersion": {
      "type": "integer",
      "enum": [1]
    },
    "changeset": {
      "type": "integer",
      "minimum": 1
    },
    "previousChangeset": {
      "type": "integer",
      "minimum": 0
    },
    "reviewRoot": {
      "type": "string",
      "pattern": "^\\$/[^\\r\\n\\t]+$",
      "maxLength": 2000
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "securityDecision": {
      "enum": [
        "pass",
        "fail",
        "manual-review-required"
      ]
    },
    "reportStatus": {
      "enum": [
        "analysis-valid",
        "html-valid",
        "html-failed"
      ]
    },
    "pipelineGate": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "finalTaskStatus": {
      "enum": [
        "pending",
        "succeeded",
        "blocked",
        "failed"
      ]
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "formats": {
      "$ref": "#/$defs/formats"
    }
  },
  "required": [
    "metaVersion",
    "changeset",
    "previousChangeset",
    "reviewRoot",
    "counts",
    "securityDecision",
    "reportStatus",
    "pipelineGate",
    "finalTaskStatus",
    "policy",
    "coverage",
    "provenance",
    "formats"
  ],
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "limitations": { "type": "integer", "minimum": 0 },
        "totalFindings": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "critical",
        "high",
        "medium",
        "low",
        "info",
        "limitations",
        "totalFindings"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockingSeverities": {
          "type": "array",
          "enum": [[
            "critical",
            "high"
          ]]
        },
        "limitationsBlock": {
          "type": "boolean",
          "enum": [true]
        },
        "mediumAction": {
          "type": "string",
          "enum": ["warning"]
        },
        "lowAction": {
          "type": "string",
          "enum": ["informational"]
        },
        "infoAction": {
          "type": "string",
          "enum": ["informational"]
        }
      },
      "required": [
        "blockingSeverities",
        "limitationsBlock",
        "mediumAction",
        "lowAction",
        "infoAction"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewComplete": { "type": "boolean", "enum": [true] },
        "enumeratedChanges": { "type": "integer", "minimum": 1 },
        "inScopeChanges": { "type": "integer", "minimum": 1 },
        "outOfScopeChanges": { "type": "integer", "minimum": 0 },
        "unreviewableChanges": { "type": "integer", "enum": [0] },
        "filesWithTextDiff": { "type": "integer", "minimum": 0 },
        "diffBytes": { "type": "integer", "minimum": 0 },
        "diffLines": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "reviewComplete",
        "enumeratedChanges",
        "inScopeChanges",
        "outOfScopeChanges",
        "unreviewableChanges",
        "filesWithTextDiff",
        "diffBytes",
        "diffLines"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generatedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "helperCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "helperVersion": { "type": "string", "maxLength": 128 },
        "apiVersion": { "type": "string", "maxLength": 64 },
        "cliVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
        "deployment": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 256 },
        "reasoningEffort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] },
        "hashes": {
          "$ref": "#/$defs/hashes"
        }
      },
      "required": [
        "generatedAt",
        "helperCommit",
        "helperVersion",
        "apiVersion",
        "cliVersion",
        "deployment",
        "reasoningEffort",
        "hashes"
      ]
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diff": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "schema": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "template": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "review": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "normalizedManifest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["diff", "schema", "template", "review", "normalizedManifest"]
    },
    "formats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewSchema": { "type": "integer", "enum": [2] },
        "metadataSchema": { "type": "integer", "enum": [1] },
        "htmlContract": { "type": "integer", "enum": [2] }
      },
      "required": ["reviewSchema", "metadataSchema", "htmlContract"]
    }
  }
}
